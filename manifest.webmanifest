{
  "id": "./",
  "name": "ScholarSync",
  "short_name": "ScholarSync",
  "description": "The student planner for Windows: weekly timetable, assignment tracker with deadlines, GPA calculator for several grading systems, and a Pomodoro focus timer with ambient sounds. Works fully offline, in English and Arabic.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#202020",
  "theme_color": "#202020",
  "categories": ["education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "icons/icon-72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/dashboard-dark.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Dashboard with GPA, pending assignments, next class and today's focus time" },
    { "src": "screenshots/timetable-week.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Weekly timetable with colour-coded classes" },
    { "src": "screenshots/assignments.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Assignments grouped by deadline" },
    { "src": "screenshots/gpa.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "GPA calculator with semesters and target planner" },
    { "src": "screenshots/focus.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Pomodoro focus timer with ambient sounds" },
    { "src": "screenshots/dashboard-arabic.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Arabic interface (right-to-left)" }
  ],
  "shortcuts": [
    { "name": "Add assignment", "short_name": "Assignment", "description": "Create a new assignment", "url": "./?action=add-assignment", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Add class", "short_name": "Class", "description": "Add a class to the timetable", "url": "./?action=add-class", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Focus timer", "short_name": "Focus", "description": "Open the Pomodoro timer", "url": "./?view=focus", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Timetable", "short_name": "Timetable", "description": "Open the weekly timetable", "url": "./?view=timetable", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] }
  ]
}
